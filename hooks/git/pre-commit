#!/usr/bin/env bash
# Run the doc checker before each commit in lx-e2espeed and lx-work (wired up through core.hooksPath).
# It also catches edits made outside Claude Code's Edit and Write tools.
set -e
checker="$(cd "$(dirname "$0")/.." && pwd)/check_docs.py"
top="$(git rev-parse --show-toplevel)"
if [ -d "$top/rules" ]; then  # the rules repo: every change to how the work is done gets a reason
  staged="$(git diff --cached --name-only)"
  if printf '%s\n' "$staged" | grep -qE '^(rules|templates|hooks|skills|vendor)/|^(CLAUDE\.md|exp\.sh|setup\.sh)$' \
     && ! printf '%s\n' "$staged" | grep -qx 'CHANGELOG.md'; then
    echo "error: rules, templates, hooks, skills, or scripts changed without an entry in CHANGELOG.md" >&2
    exit 1
  fi
  # Every check must still be able to fail, and exp.sh must still run a project's experiments; together under three seconds.
  python3 "$(dirname "$checker")/test_checks.py" >&2
  python3 "$(dirname "$checker")/test_exp.py" >&2
fi
exec python3 "$checker" "$(git rev-parse --show-toplevel)"
